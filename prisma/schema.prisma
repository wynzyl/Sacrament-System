// prisma/schema.prisma
// This file defines your database structure

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - represents system users (Admin, Priest, Cashier)
model User {
  id           String             @id @default(uuid())
  email        String             @unique
  password     String
  name         String
  role         UserRole
  status       UserStatus         @default(ACTIVE)
  availability PriestAvailability @default(AVAILABLE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime? // Soft delete timestamp

  // Relations
  appointments         Appointment[] @relation("CreatedByUser") // Appointments created by this user
  assignedAppointments Appointment[] @relation("AssignedPriest") // Appointments assigned to this priest
  payments             Payment[] // Payments processed by this cashier
  sessions             Session[] // User sessions
}

// Session model - for server-side session authentication
model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// Enum for user roles
enum UserRole {
  ADMIN
  PRIEST
  CASHIER
}

// Enum for user status (Active/Inactive)
enum UserStatus {
  ACTIVE
  INACTIVE
}

// Enum for priest availability
enum PriestAvailability {
  AVAILABLE
  DAYOFF
}

// Sacrament types available
enum SacramentType {
  BAPTISM
  WEDDING
  CONFIRMATION
  FUNERAL
  FIRST_COMMUNION
  ANOINTING_OF_SICK
  MASS_INTENTION
}

// Appointment status tracking
enum AppointmentStatus {
  PENDING // Just created
  CONFIRMED // Confirmed by admin/priest
  COMPLETED // Service completed
  CANCELLED // Cancelled
}

// Payment method options
enum PaymentMethod {
  CASH
  GCASH
}

// Where an appointment request originated
enum AppointmentSource {
  STAFF // Entered by parish staff
  ONLINE // Submitted by a parishioner through the public booking page
}

// Payment ledger entry kind. Payments are append-only: a correction is a
// REVERSAL entry (negative amount) that references the original PAYMENT.
enum PaymentKind {
  PAYMENT
  REVERSAL
}

// Appointment model - stores sacrament schedules
model Appointment {
  id              String            @id @default(uuid())
  // Human-friendly reference given to parishioners, e.g. SAC-2026-K7M4QX
  referenceNumber String            @unique
  source          AppointmentSource @default(STAFF)
  sacramentType   SacramentType

  // Participant information
  participantName  String
  participantPhone String?
  participantEmail String?

  // Participant address
  barangay String?
  city     String? @default("Urdaneta City")
  province String? @default("Pangasinan")

  // Schedule details
  scheduledDate DateTime
  scheduledTime String

  // Location and notes
  location String? @default("Immaculate Conception Parish Church")
  notes    String?

  // Status tracking
  status AppointmentStatus @default(PENDING)

  // Cancellation details (required when status becomes CANCELLED)
  cancelReason String?
  cancelledAt  DateTime?

  // Fee information (exact decimal - never Float for money)
  fee Decimal @default(0) @db.Decimal(12, 2)

  // Relationships
  // createdBy is null for appointments requested online by a parishioner
  createdBy   User?   @relation("CreatedByUser", fields: [createdById], references: [id])
  createdById String?

  // Assigned Priest
  assignedPriest   User?   @relation("AssignedPriest", fields: [assignedPriestId], references: [id])
  assignedPriestId String?

  payments     Payment[]
  requirements AppointmentRequirement[]

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete timestamp

  @@index([sacramentType])
  @@index([assignedPriestId, scheduledDate])
  @@index([scheduledDate])
  @@index([status])
}

// Payment model - tracks all payments
model Payment {
  id String @id @default(uuid())

  // Payment details
  // Exact decimal. Negative for REVERSAL entries.
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  kind          PaymentKind   @default(PAYMENT)

  // GCash specific details
  gcashRefNumber String? // Reference number for GCash

  // Receipt information (allocated sequentially in the payment transaction)
  receiptNumber String @unique

  // Reversal bookkeeping: a REVERSAL points at the PAYMENT it cancels.
  // A payment can be reversed at most once (unique).
  reversesPaymentId String?  @unique
  reversesPayment   Payment? @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversal          Payment? @relation("PaymentReversal")
  reason            String?

  // Relationships
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String

  processedBy   User   @relation(fields: [processedById], references: [id])
  processedById String // Cashier who processed

  // Timestamps
  createdAt DateTime  @default(now())
  deletedAt DateTime? // Soft delete timestamp

  @@index([createdAt])
  @@index([processedById])
  @@index([paymentMethod])
  @@index([appointmentId])
}

// Requirement checklist item for an appointment (documents, seminars, sponsors)
model AppointmentRequirement {
  id            String    @id @default(uuid())
  appointmentId String
  key           String // Stable key from lib/requirements.ts
  label         String // Label as shown when the item was created
  isMet         Boolean   @default(false)
  verifiedById  String?
  verifiedAt    DateTime?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, key])
}

// Immutable audit trail. The application only ever inserts; a database trigger
// (see the add_phase1_foundations migration) rejects UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(uuid())
  actorType  String // USER | SYSTEM | PUBLIC
  actorId    String?
  actorName  String?
  actorRole  String?
  action     String // e.g. appointment.create, payment.reverse
  entityType String // Appointment | Payment | User | AppointmentRequirement
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

// Atomic counters (e.g. receipt sequence per year)
model Counter {
  key   String @id
  value Int    @default(0)
}
